NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# Auth (B10): see context/docs/auth-setup.md
# Left empty so boot fails until a real one is set
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# Email verification (B11b): auth-setup.md § Email Verification
WEB_APP_URL=http://localhost:3000
MAIL_FROM="Lineup <onboarding@resend.dev>"
# Unset: verification links go to the server log
# RESEND_API_KEY=re_...
# Cookie scope (B13a): auth-setup.md § CORS & Cookies
# Unset in dev; e.g. lineup.gg to reach every subdomain
# COOKIE_DOMAIN=lineup.gg
# Match pool (B25): true lets unscored seed matches play
# Dev only; boot refuses true in production
MATCH_POOL_INCLUDE_UNSCORED=true
# Rate limits (B35): proxies in front of the API
# 0 locally; Railway or Fly set 1 (B45)
TRUST_PROXY_HOPS=0
# Boot refuses false in production
RATE_LIMITS_ENABLED=true
# Images (R2): public bucket base, https only
# Unset: every crestUrl and imageUrl stays null
# Real data on ingest:
# ASSET_BASE_URL=https://br-steep-paper-b1z0rlqq.storage.c-5.eu-central-1.aws.neon.tech/images
